# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trifuel

# Redis
REDIS_URL=redis://localhost:6379

# Garmin OAuth
GARMIN_CLIENT_ID=your_garmin_client_id
GARMIN_CLIENT_SECRET=your_garmin_client_secret

# Wahoo OAuth
WAHOO_CLIENT_ID=your_wahoo_client_id
WAHOO_CLIENT_SECRET=your_wahoo_client_secret

# COROS OAuth
COROS_CLIENT_ID=your_coros_client_id
COROS_CLIENT_SECRET=your_coros_client_secret

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_min_32_chars
AUTH_SECRET=your_nextauth_secret_min_32_chars

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple OAuth
APPLE_ID=your_apple_service_id
APPLE_SECRET=your_apple_private_key_pem

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
